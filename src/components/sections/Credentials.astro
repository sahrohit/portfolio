---
import Mark from '@/components/Mark.astro'
import SectionHead from '@/components/SectionHead.astro'
import { education, certifications } from '@/data/profile'
import { publications, pubMeta, bibtex } from '@/data/publications'
---

<section id="credentials" class="sec" aria-labelledby="credentials-title">
  <SectionHead
    num="03"
    title="CREDENTIALS"
    cmd="gpg --verify"
    id="credentials-title"
  >
    <Mark variant="ring" left="58%" top="24px" speed={0.55} />
    <Mark variant="dots" left="1%" top="440px" speed={0.2} />
  </SectionHead>

  <h3 class="label first">EDUCATION</h3>
  <div class="cols2 edu">
    {education.map((e) => (
      <div class="edu-cell">
        <div class="mono small-muted">{e.where}</div>
        <h4 class="edu-school">{e.school}</h4>
        <div class="edu-degree">{e.degree}</div>
        {e.grade && (
          <div>
            <span class="mono grade">{e.grade}</span>
          </div>
        )}
      </div>
    ))}
  </div>

  <h3 class="label next">LAB PAPERS</h3>
  <div class="pubs">
    {publications.map((p) => {
      const meta = pubMeta(p)
      return (
        <article class="card pub" data-pub>
          <div class="pub-head">
            <div class="mono pub-year">{p.year}</div>
            <div class="pub-body">
              <div class="mono pub-kind">{p.kind}</div>
              <h4>{p.title}</h4>
              {meta && <div class="pub-meta">{meta}</div>}
            </div>
          </div>
          <div class="pub-actions">
            <button
              class="btn sm"
              type="button"
              aria-expanded="false"
              aria-controls={`bib-${p.id}`}
            >
              {'{ } Cite BibTeX'}
            </button>
            {p.abstract && (
              <button
                class="btn sm"
                type="button"
                aria-expanded="false"
                aria-controls={`abs-${p.id}`}
              >
                Abstract preview
              </button>
            )}
          </div>
          <div class="pub-drawer" id={`bib-${p.id}`} hidden>
            <pre class="mono">{bibtex(p)}</pre>
            <button class="btn sm" type="button" data-copy>
              Copy
            </button>
          </div>
          {p.abstract && (
            <div class="pub-drawer" id={`abs-${p.id}`} hidden>
              {p.abstract}
            </div>
          )}
        </article>
      )
    })}
  </div>

  <h3 class="label next">CERTIFICATIONS</h3>
  <div class="cols2 certs">
    {certifications.map((c) => (
      <div class="card holo cert">
        <div class="cert-top">
          <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
            <path
              d="M20 3 L35 11 V22 C35 30 28 35 20 37 C12 35 5 30 5 22 V11 Z"
              fill="none"
              stroke="var(--acc)"
              stroke-width="2"
            />
            <path
              d="M13 20 L18 25 L27 15"
              fill="none"
              stroke="var(--ok)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="mono verified">VERIFIED</span>
        </div>
        <h4>{c.title}</h4>
        <div class="mono cert-issuer">{c.issuer}</div>
      </div>
    ))}
  </div>
</section>
