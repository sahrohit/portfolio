---
import { profile } from '@/data/profile'

// Desktop shows the design's four links; the mobile menu lists every section.
const links = [
  { href: '#about', label: 'About', num: '01', desktop: true },
  { href: '#experience', label: 'Experience', num: '02', desktop: true },
  { href: '#credentials', label: 'Credentials', num: '03', desktop: true },
  { href: '#blogs', label: 'Blogs', num: '04', desktop: false },
  { href: '#contact', label: 'Contact', num: '05', desktop: true },
]
const section = (href: string) => href.slice(1)
---

<nav class="topnav" aria-label="Primary">
  <span class="mono crumb">
    ~/portfolio <span class="acc">(main)</span>
  </span>
  <div class="navlinks">
    {links
      .filter((l) => l.desktop)
      .map((l) => (
        <a
          class="navlink"
          href={l.href}
          data-ga="nav_click"
          data-ga-section={section(l.href)}
          data-ga-location="topnav"
        >
          {l.label}
        </a>
      ))}
    <a
      class="navlink"
      href={profile.resume}
      target="_blank"
      rel="noopener"
      data-ga="resume_download"
      data-ga-location="topnav"
    >
      Resume ↗
    </a>
    <button
      class="btn theme-btn"
      id="theme-toggle"
      type="button"
      aria-label="Toggle color theme"
    >
      <svg
        class="i-sun"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4.5"></circle>
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg
        class="i-moon"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
      </svg>
      <span class="lbl-dark">DARK</span>
      <span class="lbl-light">LIGHT</span>
    </button>
    <button
      class="btn menu-btn"
      type="button"
      popovertarget="mnav"
      aria-controls="mnav"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      MENU
    </button>
  </div>

  <div class="mnav" id="mnav" popover>
    {links.map((l) => (
      <a
        href={l.href}
        data-ga="nav_click"
        data-ga-section={section(l.href)}
        data-ga-location="mobile_menu"
      >
        <span class="mnav-num">{l.num}</span>
        <span>{l.label}</span>
        <span aria-hidden="true">→</span>
      </a>
    ))}
    <a
      href={profile.resume}
      target="_blank"
      rel="noopener"
      data-ga="resume_download"
      data-ga-location="mobile_menu"
    >
      <span class="mnav-num"></span>
      <span>Resume (PDF)</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</nav>
