---
/** "Blue pill" easter egg: the chooser, and the postcard behind the blue pill. */
---

<dialog class="modal" id="pill" aria-label="Choose a pill">
  <div class="dlg-head mono">
    <span>choose --reality</span>
    <button class="btn sm" type="button" data-close aria-label="Close">
      ✕
    </button>
  </div>
  <div class="cols2 pill-grid">
    <button class="pill-choice" type="button" data-pill="blue" autofocus>
      <svg width="64" height="28" viewBox="0 0 64 28" aria-hidden="true">
        <rect
          x="1"
          y="1"
          width="62"
          height="26"
          rx="13"
          fill="#2563EB"
          stroke="#111827"
        ></rect>
        <path d="M32 1 V27" stroke="#1E3A8A"></path>
        <rect x="8" y="6" width="16" height="4" rx="2" fill="#93C5FD"></rect>
      </svg>
      <strong>Blue pill</strong>
      <span>Stay on Earth C-137. Get a postcard.</span>
    </button>
    <button class="pill-choice" type="button" data-pill="red">
      <svg width="64" height="28" viewBox="0 0 64 28" aria-hidden="true">
        <rect
          x="1"
          y="1"
          width="62"
          height="26"
          rx="13"
          fill="#DC2626"
          stroke="#111827"
        ></rect>
        <path d="M32 1 V27" stroke="#7F1D1D"></path>
        <rect x="8" y="6" width="16" height="4" rx="2" fill="#FCA5A5"></rect>
      </svg>
      <strong>Red pill</strong>
      <span>See the raw event stream behind the page.</span>
    </button>
  </div>
</dialog>

<dialog class="postcard" id="postcard" aria-labelledby="postcard-title">
  <div class="cols2 postcard-grid">
    <svg
      viewBox="0 0 420 300"
      role="img"
      aria-label="Illustrated landscape: mountains, a lake and pine trees at sunset"
    >
      <rect width="420" height="300" fill="#FDE7C7"></rect>
      <rect width="420" height="150" fill="#FBD5A5"></rect>
      <circle cx="300" cy="120" r="38" fill="#F97316" opacity=".85"></circle>
      <path
        d="M0 190 L70 110 L120 160 L190 70 L260 150 L310 115 L420 190 Z"
        fill="#1E3A5F"
      ></path>
      <path
        d="M190 70 L172 92 L182 90 L190 100 L200 88 L208 92 Z"
        fill="#F8FAFC"
      ></path>
      <path
        d="M0 205 L90 150 L160 195 L240 140 L330 200 L420 170 L420 215 L0 215 Z"
        fill="#2E6F9E"
      ></path>
      <rect y="210" width="420" height="90" fill="#38BDF8" opacity=".55"></rect>
      <path
        d="M30 238 H140 M190 252 H330 M70 270 H210"
        stroke="#F8FAFC"
        stroke-width="2"
        opacity=".7"
      ></path>
      <path
        d="M28 214 L40 168 L52 214 Z M50 214 L60 180 L70 214 Z M352 214 L366 160 L380 214 Z M378 214 L388 178 L398 214 Z"
        fill="#14532D"
      ></path>
      <path
        d="M120 60 q6 -6 12 0 q6 -6 12 0 M160 44 q5 -5 10 0 q5 -5 10 0"
        fill="none"
        stroke="#1F2937"
        stroke-width="2"
      ></path>
    </svg>
    <div class="postcard-copy">
      <div class="mono stamp" aria-hidden="true">
        EARTH
        <br />
        C-137
        <br />
        2¢
      </div>
      <div class="mono postcard-kicker">POSTCARD</div>
      <h2 id="postcard-title">Greetings from Earth C-137</h2>
      <p class="first">
        Whoever designed this planet did a great job. I'm out here travelling
        and discovering its natural beauties. Wish you were here.
      </p>
      <p>— R.</p>
      <div class="grow"></div>
      <button class="postcard-back" type="button" data-close autofocus>
        Back to the page
      </button>
    </div>
  </div>
</dialog>
